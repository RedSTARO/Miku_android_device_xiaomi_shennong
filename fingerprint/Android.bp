cc_defaults {
    name: "shennong_fingerprint_defaults",
    header_libs: [
        "generated_kernel_headers",
        "shennong_fingerprint_headers",
    ],
    srcs: [
        "FingerprintConfig.cpp",
        "FingerprintEngine.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
    ],
    shared_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
        "android.hardware.biometrics.common.config",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "liblog",
    ],
    whole_static_libs: [
        "libandroid.hardware.biometrics.fingerprint.shennong.Props",
    ],
    vendor: true,
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.shennong",
    defaults: ["shennong_fingerprint_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint-service.shennong.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.shennong.xml"],
    srcs: ["Fingerprint.cpp", "main.cpp"],
    relative_install_path: "hw",
}

cc_test {
    name: "shennong_fingerprint_test",
    defaults: ["shennong_fingerprint_defaults"],
    srcs: ["tests/SessionTest.cpp"],
    gtest: false,
    test_suites: ["device-tests"],
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.shennong.Props",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}

cc_library_headers {
    name: "shennong_fingerprint_headers",
    export_include_dirs: ["include"],
    header_libs: ["libhardware_headers"],
    vendor: true,
}