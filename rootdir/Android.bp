// Recovery copy only: /vendor/etc/charger_fw_fstab.qti comes from the stock blob
// (proprietary-files.txt), and Miku UI's build/soong neither accepts recovery: true
// together with vendor: true nor two installers for the same vendor file.
prebuilt_etc {
    name: "charger_fw_fstab.qti",
    src: "etc/charger_fw_fstab.qti",
    recovery: true,
}

prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.shennong.rc",
    src: "etc/init.shennong.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc_xml {
    name: "compat_framework_overrides.xml",
    src: "etc/compat_framework_overrides.xml",
    sub_dir: "appcompat",
    product_specific: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "etc/ueventd.rc",
    vendor: true,
}

prebuilt_etc {
    name: "hals.conf",
    src: "etc/sensors/hals.conf",
    sub_dir: "sensors",
    vendor: true,
}
